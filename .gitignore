# Версия 2.0 от 08.09.2026 — реорганизация структуры по универсальному стандарту
# (команда folders v2.1): добавлены секреты (set.ini), рабочие данные приложения,
# бэкапы/копии (COPY/, «run — копия.bat»), каркасы data//result/;
# общий *.json заменён точечными правилами.

# Python
__pycache__/
*.py[cod]
*.pyo

# Секреты и настройки окружения (вне git)
set.ini

# Рабочие данные приложения (генерируются при работе; вне git)
dashboard_data.json
work_state.json
seen_mail.json

# Данные и результаты: в git только каркас
data/*
!data/.gitkeep
result/*
!result/.gitkeep

# Локальные рабочие файлы и бэкапы (сами файлы не удалять)
run — копия.bat
*копия*.bat
COPY/
*.bak
*.bak_*
~$*
